#!/usr/bin/env bash
# Agent shim: substituted for the real claude CLI via CLAUDE_BIN in tests.
# Behavior selected by FAKE_CLAUDE_MODE (good | bad | noop | crash).
# Always records its full argv (one arg per line) to $FAKE_CLAUDE_ARGV_FILE
# when set, so tests can assert the prompt and flags of the invocation.
# The four NON-task invocations — the reachability probe, the conflict
# detection planner, the refactor planner and the refactor executor — are
# answered separately, by FAKE_CLAUDE_PROBE_MODE, FAKE_CLAUDE_PLAN_MODE,
# FAKE_CLAUDE_REFACTOR_PLAN_MODE and FAKE_CLAUDE_REFACTOR_MODE; see below.
# Each is recognized by the stable marker its prompt carries, so one `run` can
# make all of them through this one binary and a test can steer each
# independently.
set -u

# The invocation-level reachability probe (lib/task.sh yt_agent_precheck) is
# recognized by the marker it carries in its prompt, and answered by
# FAKE_CLAUDE_PROBE_MODE (ok | unreachable), which DEFAULTS TO ok. It is
# deliberately not FAKE_CLAUDE_MODE: that keeps meaning "how the task agent
# behaves", so e.g. crash mode still gets past preflight and reaches its
# worktree. The probe answers and exits before the recording below, so the
# argv/stdin files keep describing the task invocation only.
for _arg in "$@"; do
  case "$_arg" in
    *yolotown-agent-reachability-probe*)
      case "${FAKE_CLAUDE_PROBE_MODE:-ok}" in
        ok)
          echo "ok"
          exit 0
          ;;
        unreachable)
          echo "Invalid API key · Failed to authenticate. Please run /login" >&2
          exit 1
          ;;
        *)
          echo "fake-claude: unknown FAKE_CLAUDE_PROBE_MODE \"${FAKE_CLAUDE_PROBE_MODE}\"" >&2
          exit 99
          ;;
      esac
      ;;
  esac
done

# The conflict-detection planner (lib/plan.sh yt_plan) is recognized the same
# way — by the marker its prompt carries — and answered by FAKE_CLAUDE_PLAN_MODE
# (default disjoint). It is deliberately NOT FAKE_CLAUDE_MODE: at Stage 3
# maturity one `run` calls the planner once and then N task agents through this
# same binary, so "how the planner answers" and "how the task agent behaves"
# have to be separately settable. Like the probe, it answers and exits before
# the argv/stdin recording below, so those files keep describing the TASK
# invocation only; the planner's own argv goes to FAKE_CLAUDE_PLAN_ARGV_FILE.
#
# The canned plans are generated from the task names parsed out of the prompt's
# "TASK <name> | ..." lines, so a mode fits whatever backlog the test used:
#   disjoint (default)  every task gets its own file; no collisions
#   collide             the first two tasks share src/shared.js, reported as
#                       COLLIDING-SPLITTABLE; any others stay DISJOINT
#   coupled             same overlap, reported as INHERENTLY-COUPLED
#   hidden-collision    the first two tasks share a file but the plan claims
#                       DISJOINT and reports nothing (the dangerous answer)
#   missing-task        drops the last task from "tasks"
#   unknown-task        adds a task that is not in the backlog
#   duplicate-task      lists the first task twice
#   bad-bucket          a bucket outside the three
#   no-files            a task with an empty "files"
#   uncollided          a task bucketed COLLIDING-SPLITTABLE with no collision
#   half-collision      a collision whose shared file only one task predicts
#   prose               no JSON at all
#   truncated           JSON that does not parse
#   silent              exit 0 with no output
#   crash               exit nonzero
for _arg in "$@"; do
  case "$_arg" in
    *yolotown-conflict-detection-plan*)
      if [ -n "${FAKE_CLAUDE_PLAN_ARGV_FILE:-}" ]; then
        printf '%s\n' "$@" > "$FAKE_CLAUDE_PLAN_ARGV_FILE"
      fi
      case "${FAKE_CLAUDE_PLAN_MODE:-disjoint}" in
        crash)
          echo "fake-claude: simulated planner crash" >&2
          exit 1
          ;;
        silent)
          exit 0
          ;;
        prose)
          echo "I looked over the backlog and the tasks all seem fine to me."
          exit 0
          ;;
        truncated)
          # Braces on both ends, so this reaches the JSON parser and is
          # rejected there rather than by the "no JSON at all" check.
          printf '{"tasks": [{"name": "alpha"}\n'
          exit 0
          ;;
        *)
          FAKE_PLAN_PROMPT="$_arg" FAKE_PLAN_MODE="${FAKE_CLAUDE_PLAN_MODE:-disjoint}" node -e '
const prompt = process.env.FAKE_PLAN_PROMPT, mode = process.env.FAKE_PLAN_MODE;
const bail = (m) => { console.error("fake-claude: " + m); process.exit(99); };
const names = prompt.split("\n").filter((l) => l.startsWith("TASK "))
  .map((l) => l.slice(5).split("|")[0].trim());
if (!names.length) bail("the planner prompt carried no \"TASK <name> | ...\" lines");
const need = (n) => { if (names.length < n) bail("FAKE_CLAUDE_PLAN_MODE=" + mode + " needs at least " + n + " tasks, got " + names.length); };
const SHARED = "src/shared.js";
let tasks = names.map((n) => ({ name: n, files: ["src/" + n + ".js"], bucket: "DISJOINT" }));
let collisions = [];
const overlap = (bucket) => { need(2); tasks[0].files.push(SHARED); tasks[1].files.push(SHARED); tasks[0].bucket = bucket; tasks[1].bucket = bucket; };
switch (mode) {
  case "disjoint": break;
  case "collide":
  case "coupled":
    overlap(mode === "collide" ? "COLLIDING-SPLITTABLE" : "INHERENTLY-COUPLED");
    collisions = [{ tasks: [names[0], names[1]], files: [SHARED], reason: "both tasks rewrite " + SHARED }];
    break;
  case "hidden-collision": need(2); tasks[0].files.push(SHARED); tasks[1].files.push(SHARED); break;
  case "missing-task": need(2); tasks.pop(); break;
  case "unknown-task": tasks.push({ name: "ghost-task", files: ["src/ghost.js"], bucket: "DISJOINT" }); break;
  case "duplicate-task": tasks.push(tasks[0]); break;
  case "bad-bucket": tasks[0].bucket = "PROBABLY-FINE"; break;
  case "no-files": tasks[0].files = []; break;
  case "uncollided": tasks[0].bucket = "COLLIDING-SPLITTABLE"; break;
  case "half-collision":
    need(2);
    tasks[0].files.push(SHARED);
    tasks[0].bucket = "COLLIDING-SPLITTABLE";
    tasks[1].bucket = "COLLIDING-SPLITTABLE";
    collisions = [{ tasks: [names[0], names[1]], files: [SHARED], reason: "only one of them actually predicts it" }];
    break;
  default: bail("unknown FAKE_CLAUDE_PLAN_MODE \"" + mode + "\"");
}
// A line of chatter first, on purpose: a real model prefaces its JSON, and the
// validator has to survive that while still rejecting a response with no JSON.
process.stdout.write("Here is the conflict analysis you asked for.\n");
process.stdout.write(JSON.stringify({ tasks, collisions }, null, 2) + "\n");
'
          exit $?
          ;;
      esac
      ;;
  esac
done

# The refactor gate (lib/refactor.sh) makes TWO calls, and they are answered
# apart from each other as well as from everything above — a test has to be
# able to approve a plan and then make the execution go red, or make the
# planning itself fail before any approval is ever asked for.
#
# The EXECUTE call is matched FIRST on purpose: its prompt quotes the approved
# plan verbatim, so a plan whose text happened to mention the planning marker
# would otherwise be mistaken for a planning call.
#
#   yolotown-refactor-execute -> FAKE_CLAUDE_REFACTOR_MODE (default good)
#     good   the behavior-preserving split this fixture's gate stays green on:
#            the printing moves to src/greet.js and src/app.js calls it, so
#            `node src/app.js` still prints "app ok"
#     bad    an edit that leaves the gate RED (the refactor must be discarded
#            and the base branch must not move)
#     noop   changes nothing, exits 0
#     crash  exits nonzero
#   yolotown-refactor-plan -> FAKE_CLAUDE_REFACTOR_PLAN_MODE (default plan)
#     plan     a plausible four-heading refactor plan, naming the colliding
#              tasks and shared files it was given
#     splitless a plan that says the collision cannot be split apart (a real
#              answer a human is meant to reject)
#     silent   exit 0 with no output
#     crash    exit nonzero
# Both record their own argv (FAKE_CLAUDE_REFACTOR_ARGV_FILE,
# FAKE_CLAUDE_REFACTOR_PLAN_ARGV_FILE) and, like the probe and the planner,
# answer and exit before the task-agent recording below, so FAKE_CLAUDE_ARGV_FILE
# keeps describing the TASK invocation only.
for _arg in "$@"; do
  case "$_arg" in
    *yolotown-refactor-execute*)
      if [ -n "${FAKE_CLAUDE_REFACTOR_ARGV_FILE:-}" ]; then
        printf '%s\n' "$@" > "$FAKE_CLAUDE_REFACTOR_ARGV_FILE"
      fi
      case "${FAKE_CLAUDE_REFACTOR_MODE:-good}" in
        good)
          mkdir -p src
          cat > src/greet.js <<'EOF'
// split out of src/app.js by the refactor agent; behavior unchanged
module.exports = function greet() { console.log("app ok"); };
EOF
          cat > src/app.js <<'EOF'
require("./greet")();
EOF
          echo "I followed the approved plan: moved the printing into src/greet.js"
          echo "and left src/app.js calling it. Ran the gate; it exits 0. Done."
          exit 0
          ;;
        bad)
          printf 'this is not valid javascript {{{\n' > src/app.js
          echo "I split src/app.js as the plan asked."
          exit 0
          ;;
        noop)
          echo "Upon inspection, the files were already disjoint; I changed nothing."
          exit 0
          ;;
        crash)
          echo "fatal: simulated refactor agent crash" >&2
          exit 1
          ;;
        *)
          echo "fake-claude: unknown FAKE_CLAUDE_REFACTOR_MODE \"${FAKE_CLAUDE_REFACTOR_MODE}\"" >&2
          exit 99
          ;;
      esac
      ;;
  esac
done

for _arg in "$@"; do
  case "$_arg" in
    *yolotown-refactor-plan*)
      if [ -n "${FAKE_CLAUDE_REFACTOR_PLAN_ARGV_FILE:-}" ]; then
        printf '%s\n' "$@" > "$FAKE_CLAUDE_REFACTOR_PLAN_ARGV_FILE"
      fi
      case "${FAKE_CLAUDE_REFACTOR_PLAN_MODE:-plan}" in
        crash)
          echo "fake-claude: simulated refactor planner crash" >&2
          exit 1
          ;;
        silent)
          exit 0
          ;;
        *)
          FAKE_REFACTOR_PROMPT="$_arg" FAKE_REFACTOR_MODE="${FAKE_CLAUDE_REFACTOR_PLAN_MODE:-plan}" node -e '
const prompt = process.env.FAKE_REFACTOR_PROMPT, mode = process.env.FAKE_REFACTOR_MODE;
const pick = (p) => prompt.split("\n").filter((l) => l.startsWith(p)).map((l) => l.slice(p.length).split("|")[0].trim());
const names = pick("TASK "), files = pick("FILE ");
if (!names.length) { console.error("fake-claude: the refactor prompt carried no \"TASK <name> | ...\" lines"); process.exit(99); }
if (!files.length) { console.error("fake-claude: the refactor prompt carried no \"FILE <path>\" lines"); process.exit(99); }
if (mode !== "plan" && mode !== "splitless") { console.error("fake-claude: unknown FAKE_CLAUDE_REFACTOR_PLAN_MODE \"" + mode + "\""); process.exit(99); }
const shared = files[0], stem = shared.replace(/\.[^./]+$/, "");
if (mode === "splitless") {
  process.stdout.write("SPLIT\n  None possible. " + shared + " is one state machine; every task below\n  rewrites the same transitions, so no split makes them disjoint.\n");
  process.stdout.write("MOVES\n  (none)\nUPDATES\n  (none)\nWHY\n" + names.map((n) => "  " + n + ": still needs all of " + shared + "\n").join(""));
  process.exit(0);
}
process.stdout.write("SPLIT\n  " + shared + " splits into " + names.map((n) => stem + "-" + n + ".js").join(" and ") + ".\n");
process.stdout.write("MOVES\n" + names.map((n) => "  the " + n + " half of " + shared + " -> " + stem + "-" + n + ".js\n").join(""));
process.stdout.write("UPDATES\n  every importer of " + shared + " imports the half it actually uses.\n");
process.stdout.write("WHY\n" + names.map((n) => "  " + n + ": touches " + stem + "-" + n + ".js only, which no other task touches.\n").join(""));
'
          exit $?
          ;;
      esac
      ;;
  esac
done

if [ -n "${FAKE_CLAUDE_ARGV_FILE:-}" ]; then
  printf '%s\n' "$@" > "$FAKE_CLAUDE_ARGV_FILE"
fi

# Record what the agent's stdin looked like, when FAKE_CLAUDE_STDIN_FILE is set.
# The core runs the agent with </dev/null, so this is an instant EOF; without
# that redirect the agent inherits the caller's stdin and can read whatever it
# carries. read -t bounds the wait so a live-but-empty stdin can never hang the
# shim; a data-bearing pipe is read the moment its first line lands.
if [ -n "${FAKE_CLAUDE_STDIN_FILE:-}" ]; then
  if IFS= read -r -t 5 _line; then
    printf 'stdin: %s\n' "$_line" > "$FAKE_CLAUDE_STDIN_FILE"
  else
    printf 'stdin: <eof>\n' > "$FAKE_CLAUDE_STDIN_FILE"
  fi
fi

case "${FAKE_CLAUDE_MODE:-good}" in
  good)
    mkdir -p src
    cat > src/feature.js <<'EOF'
// added by agent
module.exports = { feature: true };
EOF
    echo "I read the task description and created src/feature.js."
    echo "Ran the acceptance gate; it exits 0. Done."
    ;;
  bad)
    printf 'this is not valid javascript {{{\n' > src/app.js
    echo "I refactored src/app.js to implement the task."
    ;;
  noop)
    echo "Upon inspection, no changes were needed."
    ;;
  crash)
    echo "fatal: simulated agent crash" >&2
    exit 1
    ;;
  *)
    echo "fake-claude: unknown FAKE_CLAUDE_MODE \"${FAKE_CLAUDE_MODE}\"" >&2
    exit 99
    ;;
esac
exit 0
